{
  "name": "post-sse",
  "version": "0.1.0",
  "description": "Zero-dependency, fetch-based Server-Sent Events client for LLM streams — POST, custom headers, AbortSignal, and reconnection, in Node and the browser. The POST + headers EventSource can't do.",
  "type": "module",
  "license": "MIT",
  "author": "Himanshu Sharma",
  "sideEffects": false,
  "keywords": [
    "sse",
    "server-sent-events",
    "eventsource",
    "fetch",
    "stream",
    "streaming",
    "post",
    "reconnect",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H1manshu01/post-sse.git"
  },
  "homepage": "https://github.com/H1manshu01/post-sse#readme",
  "bugs": {
    "url": "https://github.com/H1manshu01/post-sse/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^6.4.4"
  },
  "size-limit": [
    {
      "name": "core (sse + parseSSE)",
      "path": "dist/index.js",
      "limit": "3 kB"
    }
  ],
  "engines": {
    "node": ">=18"
  }
}
